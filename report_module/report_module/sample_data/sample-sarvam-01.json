  "transcript": [
    {
      "role": "agent",
      "text": "Namaste! Main ek NGO program ki taraf se bol rahi hoon. Yeh call lagbhag teen minute ki hogi. Kya abhi baat kar sakte hain?",
      "offset_s": 1.0,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Haan ji, boliye.",
      "offset_s": 10.5,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Dhanyavaad. Aapka naam kya hai?",
      "offset_s": 11.4,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Mera naam Test User hai.",
      "offset_s": 15.94,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Shukriya. Aapki umar kya hai?",
      "offset_s": 16.99,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Pachaas saal.",
      "offset_s": 20.64,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Theek hai. Aap kis district mein rehte hain?",
      "offset_s": 21.62,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Nahi, maine pachees kaha tha. Pachees saal.",
      "offset_s": 28.27,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Maaf kijiye, umar pachees saal. Aap kis district mein rehte hain?",
      "offset_s": 30.02,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Sample district.",
      "offset_s": 36.04,
      "language": "en-IN"
    },
    {
      "role": "agent",
      "text": "Program sessions ke liye aap kaunsi bhasha pasand karte hain?",
      "offset_s": 37.14,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Hindi.",
      "offset_s": 42.22,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Kya aapne program ka koi session attend kiya?",
      "offset_s": 43.16,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Haan, kiya tha.",
      "offset_s": 47.91,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Aapne kitne sessions attend kiye?",
      "offset_s": 48.92,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Teen sessions.",
      "offset_s": 52.88,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Aapke kitne bachche hain?",
      "offset_s": 53.87,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Do bachche.",
      "offset_s": 57.14,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Unki umar kya hai?",
      "offset_s": 58.09,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Chhe aur nau saal.",
      "offset_s": 61.43,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Ek se paanch ke scale par aap program se kitne santusht hain?",
      "offset_s": 62.45,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Char.",
      "offset_s": 67.46,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Program ko behtar banane ke liye koi sujhav?",
      "offset_s": 68.52,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Sessions shaam ko ho toh achha rahega.",
      "offset_s": 74.82,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Kya hum baad mein aapse ek chhote follow-up ke liye sampark kar sakte hain?",
      "offset_s": 75.81,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Haan, zaroor.",
      "offset_s": 82.22,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Main confirm kar leti hoon: naam Test User, umar pachees, teen sessions, do bachche, rating char. Kya yeh sahi hai?",
      "offset_s": 83.25,
      "interrupted": false
    },
    {
      "role": "caller",
      "text": "Haan, sab sahi hai.",
      "offset_s": 92.48,
      "language": "hi-IN"
    },
    {
      "role": "agent",
      "text": "Aapke samay ke liye bahut dhanyavaad. Aapka din shubh ho!",
      "offset_s": 93.48,
      "interrupted": false
    }
