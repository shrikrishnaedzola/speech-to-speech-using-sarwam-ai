# Copy this file to .env (or configure in Vercel Project Settings > Environment Variables)
# Never commit real keys or database credentials to git.

# Sarvam API key (from https://dashboard.sarvam.ai).
SARVAM_API_KEY=your_sarvam_api_key_here

# Database Configuration (MySQL)
# Example MySQL connection strings:
# Standard MySQL:
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name?charset=utf8mb4
# If using SSL (e.g. PlanetScale, Aiven, AWS RDS, DigitalOcean):
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name?ssl_ca=/etc/ssl/certs/ca-certificates.crt&charset=utf8mb4

# Optional: CORS origins (comma-separated, default: http://localhost:5180)
# For Vercel production: add your Vercel deployment URL
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5180

# Optional: STUN/TURN servers
# ICE_SERVERS=stun:stun.l.google.com:19302

# Optional: AI-written summary in post-call reports (report_module)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here


# Optional: Basic auth for the whole app (any username, this password). Recommended on Render.
# APP_PASSWORD=choose_a_strong_password

# Optional: fetch TURN credentials from Metered at call time instead of a fixed ICE_SERVERS.
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=your_metered_api_key_here
