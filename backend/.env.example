# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit a real key.

# Sarvam API key (from https://dashboard.sarvam.ai). Used ONLY by the backend.
SARVAM_API_KEY=your_sarvam_api_key_here

# Database Configuration (MySQL / SQLite)
# For MySQL:
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name?charset=utf8mb4
# For SQLite (default if omitted):
# DATABASE_URL=sqlite:///./data/tester.db

# Optional
# CORS_ORIGINS=http://localhost:5180,https://your-app.vercel.app
# ICE_SERVERS=stun:stun.l.google.com:19302

# Optional: AI-written summary in post-call reports (report_module). Leave empty to keep it off.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
